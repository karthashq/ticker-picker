# AI enrichment (optional). Adds narrative thesis and executive summary to reports.
# AI_PROVIDER: gemini | anthropic | openai | ollama | none (default: none — fully deterministic)
AI_PROVIDER=
# AI_MODEL overrides each provider's default (gemini-2.0-flash / claude-haiku-4-5-20251001 / gpt-4o-mini / llama3.2)
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Ollama (local): point to your running instance
OLLAMA_BASE_URL=http://localhost:11434

# Optional: richer fundamentals via Financial Modeling Prep.
FMP_API_KEY=

# News and signal aggregation.
# GDELT and Google Trends RSS can run without keys.
SEC_USER_AGENT=TickerPicker/0.1 your-email@example.com
FRED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=investing,stocks,SecurityAnalysis,Economics,technology,Futurology,biotech,energy
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=US
CRUNCHBASE_API_KEY=
POLYGON_API_KEY=
BENZINGA_API_KEY=

# Tier 1 newsletter thesis sources. Add RSS URLs to enable long-form full-body
# article enrichment and implied ticker extraction.
SEMIANALYSIS_RSS_URL=
STRATECHERY_RSS_URL=
FABRICATED_KNOWLEDGE_RSS_URL=
LYN_ALDEN_RSS_URL=
HOWARD_MARKS_RSS_URL=
NOT_BORING_RSS_URL=
NEWSLETTER_MAX_ARTICLES_PER_SOURCE=3

# Tier 2 bear / counter-sources. These are used to populate bear cases when
# available, while generic public counter-arguments are used as fallback.
HINDENBURG_RSS_URL=
GMO_RSS_URL=
CITRON_RSS_URL=

# Licensed or custom-feed news sources. Set these to a licensed RSS/proxy URL
# if your Bloomberg, FactSet, Quartr, PitchBook, Reuters, or CrunchSpace access
# provides one.
BLOOMBERG_RSS_URL=
FACTSET_RSS_URL=
QUARTR_RSS_URL=
PITCHBOOK_RSS_URL=
REUTERS_RSS_URL=
CRUNCHSPACE_RSS_URL=

# Optional scheduler settings.
RUN_INTERVAL_HOURS=24
REPORT_DIR=reports

# Optional runtime tuning.
MAX_GROWTH_AREAS=6
MAX_COMPANIES_PER_AREA=4
